<Window x:Class="ScreenRecorderApp.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EMANAGER Screen Recorder" Height="450" Width="320" Background="#00FFFFFF" Icon="/app.ico" WindowStyle="None" AllowsTransparency="True" WindowStartupLocation="CenterScreen" xmlns:views="clr-namespace:ScreenRecorderApp.Views;assembly=ScreenRecorderApp">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="{StaticResource WindowBackground}" BorderBrush="#333333" BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Background="#00FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="15,10,15,10">
          <TextBlock FontSize="16" FontWeight="Bold" FontFamily="Segoe UI">
            <Run Text="EMANAGER" Foreground="#FFFFFFFF" />
            <Run Text=".PRO" Foreground="{StaticResource PrimaryColor}" />
          </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button Content="" Style="{StaticResource WindowControlButton}" Click="MinimizeButton_Click" />
          <Button Content="" Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click" />
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" Margin="30">
        <TextBlock Text="Witaj ponownie" FontSize="24" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,20" HorizontalAlignment="Center" />
        <TextBlock Text="Email" Foreground="{StaticResource SecondaryText}" Margin="15,0,0,8" />
        <TextBox Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Hasło" Foreground="{StaticResource SecondaryText}" Margin="15,15,0,8" />
        <PasswordBox Name="PasswordBox" />
        <Border Name="ErrorBorder" Background="#44FF0000" CornerRadius="5" Margin="0,10">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Border}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Value="" Binding="{Binding ErrorMessage}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <TextBlock Foreground="#FF4444" Margin="10" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
        </Border>
        <Button Name="LoginBtn" Content="Zaloguj" Margin="0,20,0,0" Command="{Binding LoginCommand}" />
      </StackPanel>
    </Grid>
  </Border>
</Window>