<Window x:Class="ScreenRecorderApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EMANAGER Screen Recorder" Height="300" Width="240" Background="#00FFFFFF" Icon="/app.ico" WindowStyle="None" AllowsTransparency="True" xmlns:screenrecorderapp="clr-namespace:ScreenRecorderApp;assembly=ScreenRecorderApp" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="{StaticResource WindowBackground}" BorderBrush="#333333" BorderThickness="1" CornerRadius="8">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="0,-10,-10,4">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,0,0">
          <TextBlock FontSize="12" FontWeight="Bold" FontFamily="Segoe UI">
            <Run Text="EMANAGER" Foreground="#FFFFFFFF" />
            <Run Text=".PRO" Foreground="{StaticResource PrimaryColor}" />
          </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button Content="?" Style="{StaticResource WindowControlButton}" Click="MinimizeButton_Click" />
          <Button Content="?" Style="{StaticResource WindowCloseButton}" Command="{Binding CloseCommand}" />
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,2,0,2">
        <Grid MinHeight="22" Margin="0,0,0,8">
          <TextBlock Foreground="{StaticResource SecondaryText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding ClientName}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsRecording}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
          <TextBlock Foreground="#FF4444" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding ElapsedTime}" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
        </Grid>
        <TextBlock Text="Mikrofon" Foreground="{StaticResource SecondaryText}" FontSize="10" Margin="2,0,0,2" />
        <ComboBox DisplayMemberPath="Name" Margin="0,0,0,10" FontSize="11" ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" IsEnabled="{Binding IsNotRecording}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
          <RadioButton Content="Cały ekran" Style="{StaticResource SecondaryRadioButton}" FontSize="11" Margin="0,0,6,0" IsChecked="{Binding IsFullScreenMode, Mode=OneWay}" Command="{Binding SetFullScreenCommand}" />
          <RadioButton Content="Obszar" Style="{StaticResource SecondaryRadioButton}" FontSize="11" IsChecked="{Binding IsRegionMode, Mode=OneWay}" Command="{Binding PickRegionCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
          <Button Width="40" Height="40" BorderThickness="0" Background="#00FFFFFF" Margin="0,0,14,0" Cursor="Hand" Command="{Binding ToggleRecordingCommand}">
            <Control.Template>
              <ControlTemplate TargetType="{x:Type Button}">
                <Grid Background="#00FFFFFF">
                  <Border Name="Bg" Background="{StaticResource PrimaryColor}" Width="36" Height="36" CornerRadius="18" />
                </Grid>
                <ControlTemplate.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsRecording}">
                    <Setter TargetName="Bg" Property="Border.CornerRadius" Value="5" />
                    <Setter TargetName="Bg" Property="FrameworkElement.Width" Value="18" />
                    <Setter TargetName="Bg" Property="FrameworkElement.Height" Value="18" />
                  </DataTrigger>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Value="{StaticResource PrimaryHoverColor}" Property="Border.Background" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Control.Template>
          </Button>
          <Button Width="40" Height="40" BorderThickness="0" Background="#00FFFFFF" Cursor="Hand" Command="{Binding ToggleMuteCommand}">
            <Control.Template>
              <ControlTemplate TargetType="{x:Type Button}">
                <Grid Background="#00FFFFFF">
                  <Path Name="MicIcon" Data="M12,14 C13.66,14 14.99,12.66 14.99,11 L15,5 C15,3.34 13.66,2 12,2 C10.34,2 9,3.34 9,5 L9,11 C9,12.66 10.34,14 12,14 M17.3,11 C17.3,14 14.760000000000002,16.1 12,16.1 C9.239999999999998,16.1 6.7,14 6.7,11 L5,11 C5,14.41 7.720000000000001,17.23 11,17.72 L11,21 L13,21 L13,17.72 C16.28,17.24 19,14.419999999999998 19,11 L17.3,11" Fill="#FFFFFFFF" Stretch="Uniform" Width="15" Height="20" />
                  <Path Name="SlashIcon" Data="M2,2 L22,26" Stroke="{StaticResource PrimaryColor}" StrokeThickness="2.5" Visibility="Collapsed" Margin="11,9" />
                </Grid>
                <ControlTemplate.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsMuted}">
                    <Setter TargetName="MicIcon" Value="{StaticResource SecondaryText}" Property="Shape.Fill" />
                    <Setter TargetName="SlashIcon" Property="UIElement.Visibility" Value="Visible" />
                  </DataTrigger>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="MicIcon" Property="UIElement.Opacity" Value="0.7" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Control.Template>
          </Button>
        </StackPanel>
      </StackPanel>
      <Grid Row="2">
        <Button Background="#00FFFFFF" Foreground="{StaticResource SecondaryText}" Cursor="Hand" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="Wyloguj" Margin="0,0,0,0" Width="24" Height="24" Command="{Binding LogoutCommand}">
          <Path Data="M17,17.25 L17,14 L10,14 L10,10 L17,10 L17,6.75 L22.25,12 L17,17.25 M13,2 A2,2 0 0 1 15,4L15,8 L13,8 L13,4 L4,4 L4,20 L13,20 L13,16 L15,16 L15,20 A2,2 0 0 1 13,22L4,22 A2,2 0 0 1 2,20L2,4 A2,2 0 0 1 4,2L13,2" Fill="{StaticResource SecondaryText}" Stretch="Uniform" Width="13" Height="13" />
        </Button>
      </Grid>
    </Grid>
  </Border>
</Window>
